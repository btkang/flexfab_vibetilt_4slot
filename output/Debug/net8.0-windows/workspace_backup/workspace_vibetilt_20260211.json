{
  "libraries": [
	{
      "filename": "ff_common.dll",
      "classname": "Cantops.FlexFab.Ctsp",
      "id": "ctsp",
      "config": {}
    },
    
  
	
    {
      "filename": "ff_common.dll",
      "classname": "Cantops.FlexFab.Uart",
      "id": "uart_232",
      "config": {
        "port": "COM3",
        "baudrate": 115200,
        "databits": 8,
        "parity": "None",
        "stopbits": "One"
      }
    },
    {
      "filename": "ff_vibetilt.dll",
      "classname": "Cantops.FlexFab.VibeTilt",
      "id": "vibetilt",
      "config": {
        "uart_232": "uart_232"
      }
    }
  ],
  "projects": [
    {
      "id": "prj-vibetilt",
      "name": "VibeTilt 검사",
      
	  "library_depencency": ["ctsp", "uart_232", "vibetilt"],
      "procs": [
        {
          "libid": "vibetilt",
          "id": "VER_232",
          "name": "버전 통신검사",
          "param": {
            "TIMEOUT": 5000,
            "tests": [
              {
                "command": "<VER>",
                "expected_response": "VER"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "SENTEMP_232",
          "name": "센서온도",
          "param": {
            "TIMEOUT": 5000,
            "min": 20,
            "max": 40,
            "tests": [
              {
                "command": "<SENTEMP>"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "APPCFG_232",
          "name": "Config확인",
          "param": {
            "TIMEOUT": 5000,
            "tests": [
              {
                "command": "<MODE,0>",
                "expected_response": "[MODE,0,00]"
              },
              {
                "command": "<APPCFG>",
                "expected_response": "[APPCFG,0,00/10/1/115200]"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "VIBE_232",
          "name": "진동검사",
          "param": {
            "TIMEOUT": 10000,
            "line_ending": "lf",
            "one_min": 0.9,
            "one_max": 1.1,
            "zero_min": -0.1,
            "zero_max": 0.1,
            "rms_min": 0.5,
            "rms_max": 0.65,
            "sampling_ms": 10,
            "operator_prompt": "지그를 앞/뒤 좌/우로 움직여주세요.\nPASS 조건: 1축 0.9~1.1, 0축 -0.1~0.1, RMS 0.5~0.65",
            "tests": [
              {
                "command": "<MODE,2>"
              },
              {
                "command": "<SAM,10>"
              },
              {
                "command": "<START>"
              },
              {
                "command": "<GAC>"
              },
              {
                "command": "<STOP>"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "TILT_232",
          "name": "기울기검사",
          "param": {
            "TIMEOUT": 10000,
            "DURATION": 3000,
            "line_ending": "lf",
            "alive_check": true,
            "alive_min_delta_x": 40,
            "alive_min_delta_y": 25,
            "x_min": -60.0,
            "x_max": 60.0,
            "y_min": -60.0,
            "y_max": 60.0,
            "sampling_ms": 10,
            "tilt_baud": 115200,
            "normal_baud": 115200,
            "tests": [
              {
                "command": "<MODE,6>"
              },
              {
                "command": "<START>"
              },
              {
                "command": "<AN>"
              },
              {
                "command": "<STOP>"
              }
            ]
          }
        }
      ]
    }
  ],
  "active_project": "prj-vibetilt"
}
