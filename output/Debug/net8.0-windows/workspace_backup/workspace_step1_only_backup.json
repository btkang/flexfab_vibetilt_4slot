{
  "libraries": [
	{
      "filename": "ff_common.dll",
      "classname": "Cantops.FlexFab.Ctsp",
      "id": "ctsp",
      "config": {}
    },
    
  
	
    {
      "filename": "ff_common.dll",
      "classname": "Cantops.FlexFab.Uart",
      "id": "uart_232",
      "config": {
        "port": "COM3",
        "baudrate": 115200,
        "databits": 8,
        "parity": "None",
        "stopbits": "One"
      }
    },
    {
      "filename": "ff_vibetilt.dll",
      "classname": "Cantops.FlexFab.VibeTilt",
      "id": "vibetilt",
      "config": {
        "uart_232": "uart_232"
      }
    }
  ],
  "projects": [
    {
      "id": "prj-vibetilt",
      "name": "VibeTilt 검사",
      
	  "library_depencency": ["ctsp", "uart_232", "vibetilt"],
      "procs": [
        {
          "libid": "vibetilt",
          "id": "VER_232",
          "name": "버전 통신검사",
          "param": {
            "TIMEOUT": 5000,
            "tests": [
              {
                "command": "<VER>",
                "expected_response": "VER"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "SENTEMP_232",
          "name": "센서온도",
          "param": {
            "TIMEOUT": 5000,
            "min": 20,
            "max": 40,
            "tests": [
              {
                "command": "<SENTEMP>"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "APPCFG_232",
          "name": "Config확인",
          "param": {
            "TIMEOUT": 5000,
            "tests": [
              {
                "command": "<MODE,0>",
                "expected_response": "[MODE,0,00]"
              },
              {
                "command": "<APPCFG>",
                "expected_response": "[APPCFG,0,00/10/1/115200]"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "VIBE_232",
          "name": "진동검사",
          "param": {
            "TIMEOUT": 5000,
            "line_ending": "lf",
            "one_min": 0.8,
            "one_max": 1.2,
            "zero_min": -0.2,
            "zero_max": 0.2,
            "rms_min": 0.4,
            "rms_max": 0.75,
            "sampling_ms": 10,
            "pass_consecutive_count": 2,
            "operator_prompt": "진동검사\nOK버튼을 누르면 검사가 시작됩니다.\n지그를 앞/뒤 좌/우로 움직여주세요.\nPASS 조건: 1축 0.8~1.2, 0축 -0.2~0.2, RMS 0.4~0.75",
            "tests": [
              {
                "command": "<MODE,2>"
              },
              {
                "command": "<SAM,10>"
              },
              {
                "command": "<START>"
              },
              {
                "command": "<GAC>"
              },
              {
                "command": "<STOP>"
              }
            ]
          }
        },
        {
          "libid": "vibetilt",
          "id": "TILT_232",
          "name": "기울기검사",
          "param": {
            "TIMEOUT": 5000,
            "DURATION": 5000,
            "line_ending": "lf",
            "alive_check": true,
            "alive_min_delta_x": 20,
            "alive_min_delta_y": 15,
            "x_min": -80.0,
            "x_max": 80.0,
            "y_min": -80.0,
            "y_max": 80.0,
            "sampling_ms": 10,
            "tilt_baud": 115200,
            "normal_baud": 115200,
            "operator_prompt": "기울기검사\nOK버튼을 누르면 검사가 시작됩니다.\n센서를 앞/뒤/좌/우로 기울여주세요.\nPASS 조건: X축 변화 ≥20° 또는 Y축 변화 ≥15°",
            "tests": [
              {
                "command": "<MODE,6>"
              },
              {
                "command": "<START>"
              },
              {
                "command": "<AN>"
              },
              {
                "command": "<STOP>"
              }
            ]
          }
        }
      ]
    }
  ],
  "active_project": "prj-vibetilt"
}
